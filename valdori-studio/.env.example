# İletişim formu — e-posta gönderimi (Resend: https://resend.com)
# Üçü de tanımlı değilse form mesaj GÖNDERMEZ ve kullanıcıya bunu açıkça söyler.

# Resend API anahtarı (gizli; yalnızca sunucuda okunur)
RESEND_API_KEY=

# Mesajların düşeceği gelen kutusu
CONTACT_TO_EMAIL=

# Gönderen adres — Resend'de doğrulanmış bir alan adına ait olmalı
# Örnek: "Valdori Web <form@valdoridigital.net>"
CONTACT_FROM_EMAIL=
